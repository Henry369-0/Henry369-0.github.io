---
interface Props {
  title: string;
  summary: string;
  status: string;
  href: string;
  tags: readonly string[];
}

const { title, summary, status, href, tags } = Astro.props;
const isPublic = href.length > 0;
---

<article class="project-card">
  <p class="eyebrow">{isPublic ? "公开项目" : "持续构建中"}</p>
  <h3>{title}</h3>
  <p>{summary}</p>
  <ul class="tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  {isPublic && <a href={href} target="_blank" rel="noreferrer">查看项目 ↗</a>}
</article>
