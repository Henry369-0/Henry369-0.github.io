---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";
---

<Base>
  <main class="page">
    <header class="hero">
      <div class="hero-intro">
        <div>
          <p class="eyebrow">PERSONAL PORTFOLIO / 2026</p>
          <h1>{site.name}</h1>
          <p class="statement">{site.statement}</p>
        </div>
        <img class="avatar" src="/avatar.png" alt={`${site.name} 的卡通头像`} />
      </div>
      <ul class="role-list">
        {site.roles.map((role) => <li>{role}</li>)}
      </ul>
      <nav class="hero-nav" aria-label="页面导航">
        <a href="#education">教育背景</a>
        <a href="#ai-practice">AI 工作方法</a>
        <a href="#case-notes">思考记录</a>
        <a href="#selected-work">公开项目</a>
        <a href="#contact">联系我</a>
      </nav>
    </header>

    <section id="education" class="section education-section">
      <div class="section-heading"><span>01</span><h2>Education</h2></div>
      <p class="section-lead">教育背景是我思考方式的一部分：先建立基础训练，再不断把抽象问题带回真实世界。</p>
      <div class="education-list">
        {site.education.map((item) => (
          <article class="education-item">
            <div class="education-meta"><strong>{item.degree}</strong><span>{item.school}</span><small>{item.period}</small></div>
            <div><h3>{item.field}</h3>
            <p>{item.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="education-themes" class="section education-themes">
      <div class="section-heading"><span>02</span><h2>What I Carry Forward</h2></div>
      <div class="theme-grid">
        {site.educationThemes.map((item) => (
          <article class="theme-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="ai-practice" class="section">
      <div class="section-heading"><span>03</span><h2>AI Practice</h2></div>
      <div class="card-grid">
        {site.capabilities.map((item) => (
          <article class="capability-card">
            <span class="number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="selected-thinking" class="section">
      <div class="section-heading"><span>04</span><h2>Selected Thinking</h2></div>
      <p class="section-lead">这里不复述完整项目，而是记录我如何把模糊问题变成可分析、可验证、可推进的下一步。</p>
      <div class="thinking-list">
        {site.thinking.map((item) => (
          <article class="thinking-card">
            <span class="number">{item.number}</span>
            <div><h3>{item.title}</h3><p>{item.body}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section id="case-notes" class="section">
      <div class="section-heading"><span>05</span><h2>Case Notes</h2></div>
      <div class="case-list">
        {site.caseNotes.map((item) => (
          <article class="case-note">
            <p class="eyebrow">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="selected-work" class="section">
      <div class="section-heading"><span>06</span><h2>Selected Work</h2></div>
      <p class="section-lead">项目只作为能力的公开证据入口；没有公开链接的内容，先保持脱敏和持续构建状态。</p>
      <div class="card-grid">
        {site.projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section id="privacy-boundary" class="section boundary-section">
      <div class="section-heading"><span>07</span><h2>Public by Design</h2></div>
      <p class="section-lead">这是一份公开作品集，不是内部工作档案。每一项内容都先经过公开性、证据和个人贡献边界的判断。</p>
      <div class="boundary-list">
        {site.privacyBoundary.map((item) => (
          <article class="boundary-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <footer id="contact" class="contact section">
      <div class="section-heading"><span>08</span><h2>Contact</h2></div>
      <div class="contact-links">
        <a href={site.contact.github}>GitHub Profile ↗</a>
        <a href={site.contact.page}>Portfolio ↗</a>
        {site.contact.email.length > 0 && <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}
      </div>
    </footer>
  </main>
</Base>
